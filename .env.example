# Copie para .env e ajuste. O .env NUNCA e versionado.

# --- Postgres (casa com o docker-compose.yml) ---
ARIADNE_PG_HOST=localhost
ARIADNE_PG_PORT=15432
ARIADNE_PG_USER=ariadne
ARIADNE_PG_PASSWORD=ariadne
ARIADNE_PG_DATABASE=ariadne

# Nome do grafo criado no Apache AGE
ARIADNE_GRAPH_NAME=ariadne

# --- LLM ---
# ollama | openai | anthropic
ARIADNE_LLM_PROVIDER=ollama
ARIADNE_LLM_MODEL=qwen2.5:7b-instruct
ARIADNE_OLLAMA_BASE_URL=http://localhost:11434
# So necessario quando o provider nao e ollama:
# ARIADNE_LLM_API_KEY=

# --- Embeddings ---
ARIADNE_EMBEDDING_MODEL=BAAI/bge-m3
ARIADNE_EMBEDDING_DIM=1024
ARIADNE_EMBEDDING_MODEL_OLLAMA=bge-m3
